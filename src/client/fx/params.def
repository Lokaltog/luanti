// Luanti "fx" fork: the settings registry. The ONE place a tunable is declared.
// SPDX-License-Identifier: LGPL-2.1-or-later
//
// Every entry becomes, without further edits:
//   - a member of fx::Params (fx::Params::<name>)
//   - the default for setting fx_<name> (defaultsettings.cpp includes this file)
//   - a change callback, with the apply policy below
//   - for FX_BOOL with a label: a checkbox in the tuner (a hard toggle;
//     SHADERS toggles compile the effect out: GLSL define FX_ON_<NAME>)
//   - for FX_FLOAT: a slot in the FxParams uniform block and a GLSL accessor
//     fx<CamelName> (fx_generated/params.glsl), a tuner slider and a mood key
//     when TUNE
// builtin/settingtypes.txt documents them; TestFx checks the two agree.
//
// Apply policy, what a change at runtime does:
//   LIVE     takes effect next frame
//   SHADERS  recompiles the shaders (a shader define)
//   RESTART  takes effect for the next world; frozen in fx::Caps meanwhile
//
// FX_BOOL (name, default, apply, label)   label: a tuner checkbox ("" = none)
// FX_INT  (name, default, min, max, apply)
// FX_FLOAT(name, default, min, max, apply, tune, label)

FX_BOOL (enable, true, RESTART, "")
FX_BOOL (hdr_composite, true, RESTART, "")
FX_INT  (tonemapper,              1,     0, 2,        SHADERS)
FX_FLOAT(exposure,                1.5f,  0.1f, 8.f,   LIVE, TUNE,    "Exposure")
FX_FLOAT(grade_saturation,        1.0f,  0.f, 2.f,    LIVE, TUNE,    "Saturation")
FX_FLOAT(grade_contrast,          1.0f,  0.5f, 2.f,   LIVE, TUNE,    "Contrast")
FX_FLOAT(grade_warmth,            0.0f, -1.f, 1.f,    LIVE, TUNE,    "Warmth")
FX_FLOAT(vignette,                0.1f,  0.f, 1.f,    LIVE, TUNE,    "Vignette")
FX_FLOAT(fog_blur,                0.5f,  0.f, 4.f,    LIVE, TUNE,    "Fog blur")
FX_FLOAT(lens_dirt,               0.4f,  0.f, 2.f,    LIVE, TUNE,    "Lens dirt")
FX_FLOAT(end_sky,                 1.0f,  0.f, 2.f,    LIVE, TUNE,    "End sky")
FX_FLOAT(portal_warp,             1.0f,  0.f, 2.f,    LIVE, TUNE,    "Portal warp")
FX_FLOAT(damage_fx,               1.0f,  0.f, 2.f,    LIVE, TUNE,    "Damage and low health")
FX_FLOAT(lightning_flash,         1.0f,  0.f, 2.f,    LIVE, TUNE,    "Lightning flash")
FX_FLOAT(wetness,                 1.0f,  0.f, 2.f,    LIVE, TUNE,    "Wet surfaces")
FX_FLOAT(snow,                    1.0f,  0.f, 2.f,    LIVE, TUNE,    "Snow cover")
FX_FLOAT(wind,                    1.0f,  0.f, 3.f,    LIVE, TUNE,    "Wind")
FX_FLOAT(idle_breath,             1.0f,  0.f, 3.f,    LIVE, TUNE,    "Idle breathing")
FX_FLOAT(lava_pulse,              1.0f,  0.f, 2.f,    LIVE, TUNE,    "Lava pulse")
FX_FLOAT(end_aura,                1.0f,  0.f, 3.f,    LIVE, TUNE,    "End aura")
FX_FLOAT(volumetric,              1.0f,  0.f, 4.f,    LIVE, TUNE,    "Volumetric light")
FX_FLOAT(height_fog,              0.6f,  0.f, 4.f,    LIVE, TUNE,    "Height fog")
FX_FLOAT(height_fog_base,         4.0f,  -64.f, 256.f, LIVE, NOTUNE, "Height fog base")
FX_FLOAT(gi,                      0.6f,  0.f, 3.f,    LIVE, TUNE,    "Bounce light")
FX_FLOAT(bloom_threshold,         1.0f,  0.f, 8.f,    LIVE, TUNE,    "Bloom threshold")
FX_FLOAT(bloom_knee,              0.5f,  0.f, 1.f,    LIVE, TUNE,    "Bloom knee")
FX_FLOAT(bloom_intensity,         0.35f,  0.f, 4.f,    LIVE, TUNE,    "Bloom intensity")
FX_FLOAT(emissive_strength,       2.5f,  0.f, 32.f,   LIVE, TUNE,    "Emissive strength")
FX_FLOAT(auto_emissive_threshold, 0.55f, 0.f, 0.99f,  RESTART, NOTUNE, "Auto-emissive threshold")
FX_BOOL (colored_light, true, RESTART, "Coloured light")
FX_FLOAT(light_saturation,        0.5f, 0.f, 1.5f,   LIVE, TUNE,    "Light colour")
FX_FLOAT(light_gather_radius,     48.f,  16.f, 128.f, LIVE, NOTUNE,  "Light gather radius")
FX_FLOAT(flicker,                 0.08f, 0.f, 0.5f,   LIVE, TUNE,    "Flicker")
