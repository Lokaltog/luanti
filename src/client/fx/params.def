FX_FLOAT(sky_tint,                0.6f,  0.f, 1.5f,   LIVE, TUNE,    "Sky light tint")
FX_FLOAT(ambient_floor,           0.03f, 0.f, 0.15f,  LIVE, TUNE,    "Ambient floor")
FX_FLOAT(rim_light,               0.25f, 0.f, 1.f,    LIVE, TUNE,    "Rim light (mobs)")
FX_BOOL (materials, true, RESTART, "Material maps")
FX_BOOL (smooth_material_maps, true, LIVE, "Smooth material maps")
FX_FLOAT(normal_strength,         1.0f,  0.f, 2.f,    LIVE, TUNE,    "Normal maps")
FX_FLOAT(parallax_depth,          0.03f, 0.f, 0.2f,   LIVE, TUNE,    "Parallax depth")
FX_FLOAT(specular,                0.6f,  0.f, 3.f,    LIVE, TUNE,    "Specular")
FX_FLOAT(glints,                  0.4f,  0.f, 3.f,    LIVE, TUNE,    "Glints")
FX_BOOL (particles, true, LIVE, "Ambient particles")
FX_FLOAT(heat_haze,               0.5f,  0.f, 3.f,    LIVE, TUNE,    "Heat haze")
FX_FLOAT(contact_shadows,         0.4f,  0.f, 1.5f,   LIVE, TUNE,    "Contact shadows")

// Hard toggles: off compiles the effect out of the shaders (FX_ON_<NAME>)
FX_BOOL (use_parallax,            true,  SHADERS, "Parallax")
FX_BOOL (use_specular,            true,  SHADERS, "Specular highlights")
FX_BOOL (use_glints,              true,  SHADERS, "Glints")
